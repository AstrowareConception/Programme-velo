{
  "name": "veloquest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-pwa.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:static": "npm run check:architecture && npm run check:docs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "@types/leaflet": "^1.9.15",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0"
  }
}
