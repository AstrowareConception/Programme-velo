{
  "name": "veloquest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-pwa.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests",
    "test:e2e": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:static": "npm run check:architecture && npm run check:docs",
    "test:cloud": "firebase emulators:exec --only auth,firestore --project demo-veloquest \"vitest run --dir cloud-tests && playwright test --config=playwright.cloud.config.ts\""
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "leaflet": "^1.9.4",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "firebase-tools": "^15.33.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
